---
import '../styles/global.css';
import { negoci } from '../config';
import { textos, type Lang } from '../i18n/textos';

interface Props {
  lang: Lang;
  title?: string;
  alternates?: { ca: string; es: string };
}
const { lang, title, alternates = { ca: '/', es: '/es/' } } = Astro.props;
const t = textos[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {negoci.demo && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="ca" href={new URL(alternates.ca, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
  </head>
  <body>
    <slot />
  </body>
</html>
