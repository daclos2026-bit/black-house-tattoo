---
// Formulari de cita. No té backend: munta el missatge, el copia al porta-retalls i obre el xat
// d'Instagram de l'estudi (ig.me). La lògica és a src/scripts/cita.ts.
// PENDIENTE: si accepten donar un WhatsApp, canviar-ho a wa.me amb el text ja escrit (com a les altres webs).
import { textos, type Lang } from '../i18n/textos';
import { artistes, dmLink } from '../config';
const { lang } = Astro.props as { lang: Lang };
const t = textos[lang].cita;
const opcionsArtista = [...artistes.map((a) => [a.id, a.nom]), ['qualsevol', t.qualsevol]];
---

<section id="cita" class="border-t border-linia bg-negre-2">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-24 md:py-32 lg:grid-cols-[1fr_1.25fr]">
    <div class="revela lg:sticky lg:top-28 lg:self-start">
      <p class="sobre">{t.sobre}</p>
      <h2 class="titol mt-4 text-4xl md:text-6xl">{t.titol}</h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-os/75">{t.text}</p>

      <!-- Previsualització del missatge, com una bombolla de xat -->
      <div class="mt-10 max-w-md">
        <p class="text-sm text-gris">{t.previa}</p>
        <div class="mt-3 rounded-2xl rounded-br-sm bg-gradient-to-br from-magenta to-magenta-fosc p-5 text-[0.95rem] leading-relaxed whitespace-pre-line text-white shadow-[0_0_40px_rgb(255_45_149/0.25)]">
          <output data-previa form="form-cita">{t.missatge.hola}</output>
        </div>
      </div>
    </div>

    <form id="form-cita" class="revela grid gap-7" data-lang={lang} data-dm={dmLink()} novalidate>
      <fieldset>
        <legend class="mb-3 font-semibold">{t.artista}</legend>
        <div class="grid grid-cols-3 gap-2">
          {opcionsArtista.map(([v, l], i) => (
            <label class="xip cursor-pointer px-3 py-3 text-center text-sm font-semibold">
              <input type="radio" name="artista" value={v} data-text={l} class="sr-only" checked={i === 2} /> {l}
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-3 font-semibold">{t.tipus}</legend>
        <div class="grid grid-cols-2 gap-2">
          {t.tipusOpcions.map(([v, l], i) => (
            <label class="xip cursor-pointer px-3 py-3 text-sm font-semibold">
              <input type="radio" name="tipus" value={v} data-text={l} class="sr-only" checked={i === 0} /> {l}
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-3 font-semibold">{t.mida}</legend>
        <div class="grid grid-cols-2 gap-2">
          {t.mides.map(([v, l]) => (
            <label class="xip cursor-pointer px-3 py-3 text-sm font-semibold">
              <input type="radio" name="mida" value={v} data-text={l} class="sr-only" /> {l}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="grid gap-2">
          <span class="font-semibold">{t.zona}</span>
          <input name="zona" class="camp" placeholder={t.zonaPh} autocomplete="off" />
        </label>
        <label class="grid gap-2">
          <span class="font-semibold">{t.nom}</span>
          <input name="nom" class="camp" autocomplete="given-name" />
        </label>
      </div>

      <label class="grid gap-2">
        <span class="font-semibold">{t.idea}</span>
        <textarea name="idea" rows="4" class="camp resize-y" placeholder={t.ideaPh}></textarea>
      </label>

      <div>
        <a href={dmLink()} target="_blank" rel="noopener" data-enviar class="btn btn-magenta w-full sm:w-auto">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" /></svg>
          {t.enviar}
        </a>
        <p data-resultat role="status" class="mt-4 min-h-6 text-sm text-cian"></p>
        <textarea data-copia readonly rows="6" class="camp mt-2 hidden text-sm"></textarea>
        <p class="mt-3 text-sm text-gris">{t.nota}</p>
      </div>
    </form>
  </div>
</section>

<script>
  import { iniciaCita } from '../scripts/cita';
  iniciaCita();
</script>
